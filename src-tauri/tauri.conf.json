{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carrier",
  "version": "0.1.0",
  "identifier": "app.carrier.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carrier",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
